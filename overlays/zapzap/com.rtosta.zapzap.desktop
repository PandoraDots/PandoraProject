[Desktop Entry]
Version=1.0
Name=ZapZap
Comment[pt_BR]=WhatsApp Desktop para Linux (tema Pandora Inferno)
Comment=WhatsApp Desktop for Linux (Pandora Inferno theme)
Exec=__PANDORA_ROOT__/scripts/zapzap-pandora %u
Icon=com.rtosta.zapzap
Type=Application
Categories=Chat;Network;InstantMessaging;Qt;
Keywords=WhatsApp;Chat;ZapZap;
StartupWMClass=zapzap
MimeType=x-scheme-handler/whatsapp
Terminal=false
SingleMainWindow=true
X-GNOME-UsesNotifications=true
X-GNOME-SingleWindow=true
