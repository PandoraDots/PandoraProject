{
    "packages": {
        "required": [
            "base-devel",
            "git",
            "cmake",
            "ninja",
            "python",
            "python-hatchling",
            "python-hatch-vcs",
            "python-pillow",
            "hyprland",
            "foot",
            "fastfetch",
            "btop",
            "fish",
            "paru",
            "pipewire",
            "pipewire-pulse",
            "wireplumber",
            "greetd",
            "greetd-tuigreet",
            "uwsm",
            "quickshell-git",
            "qt6-shadertools",
            "libpipewire",
            "libqalculate",
            "aubio",
            "cava",
            "cmatrix",
            "tty-clock",
            "ttf-material-symbols-variable",
            "ttf-cascadia-code-nerd",
            "nvidia-utils",
            "mesa",
            "intel-media-driver",
            "power-profiles-daemon",
            "qtengine",
            "libcava",
            "darkly-bin",
            "gvfs",
            "fuse2",
            "tumbler",
            "thunar-volman"
        ],
        "optional": [
            "sddm",
            "pipewire-jack",
            "caelestia-sddm-locklike-git",
            "spotify",
            "spicetify-cli",
            "cursor-bin",
            "equibop-bin",
            "zapzap",
            "planify",
            "freedownloadmanager",
            "vlc",
            "gvfs-mtp",
            "goverlay",
            "nvtop",
            "cpu-x",
            "prismlauncher",
            "flite",
            "glfw",
            "openal",
            "orca",
            "visualvm",
            "xorg-xrandr",
            "jdk21-openjdk",
            "jre8-openjdk",
            "gamemode",
            "dotnet-runtime-8.0"
        ],
        "cachyos_drivers": true
    },
    "commands": {
        "required": [
            "caelestia",
            "qs",
            "paru",
            "hyprctl",
            "foot",
            "fastfetch",
            "btop",
            "fish",
            "uwsm"
        ],
        "optional": [
            "cava",
            "cmatrix",
            "tty-clock",
            "cursor",
            "spotify",
            "spicetify",
            "goverlay",
            "nvtop",
            "cpu-x",
            "hydralauncher",
            "prismlauncher",
            "orion-launcher"
        ]
    },
    "files": {
        "required": [
            "~/.config/caelestia/cli.json",
            "~/.config/caelestia/shell.json",
            "~/.config/caelestia/hypr-user.lua",
            "~/.config/caelestia/hypr-vars.lua",
            "~/.config/fastfetch/config.jsonc",
            "~/.config/cava/config",
            "~/.config/fish/functions/fish_greeting.fish",
            "~/.config/caelestia/gpu-profile.env"
        ],
        "optional": [
            "~/.face",
            "~/Pictures/Wallpapers",
            "$PANDORA_ROOT/Wallpapers/glassesredjapan.jpg",
            "~/.config/xfce4/xfconf/xfce-perchannel-xml/thunar.xml",
            "~/.config/user-dirs.dirs",
            "~/.local/bin/hydralauncher",
            "~/.local/bin/hydralauncher-4.0.5.AppImage",
            "~/.local/share/applications/hydralauncher-4.0.5.desktop",
            "~/.local/share/applications/io.hydralauncher.Hydra.desktop",
            "~/.local/share/icons/hicolor/256x256/apps/io.hydralauncher.Hydra.png",
            "~/.local/bin/orion-launcher",
            "~/.local/share/applications/org.orionbedrock.OrionLauncher.desktop",
            "~/.local/share/icons/hicolor/256x256/apps/org.orionbedrock.OrionLauncher.png"
        ]
    },
    "file_contains": [
        {
            "path": "~/.config/caelestia/hypr-user.lua",
            "pattern": "kb_layout",
            "label": "teclado br-abnt2 no Hyprland"
        },
        {
            "path": "~/.config/caelestia/hypr-user.lua",
            "pattern": "pandora-info",
            "label": "dashboard workspace 1"
        },
        {
            "path": "~/.config/caelestia/hypr-vars.lua",
            "pattern": "SUPER + G",
            "label": "Super+G Spotify/Spicetify"
        },
        {
            "path": "~/.config/caelestia/shell.json",
            "pattern": "\"recolour\": true",
            "label": "recolour icons ativo"
        },
        {
            "path": "~/.config/user-dirs.dirs",
            "pattern": "XDG_PICTURES_DIR=\"$HOME/Pictures\"",
            "label": "user-dirs Pictures (English)"
        },
        {
            "path": "~/.config/xfce4/xfconf/xfce-perchannel-xml/thunar.xml",
            "pattern": "THUNAR_EXECUTE_SHELL_SCRIPT_ASK",
            "label": "Thunar shell scripts ASK"
        },
        {
            "path": "~/.config/fastfetch/config.jsonc",
            "pattern": "berserk-logo",
            "label": "logo Berserk no fastfetch"
        },
        {
            "path": "~/.config/fastfetch/config.jsonc",
            "pattern": "______",
            "label": "banner ASCII Caelestia no fastfetch"
        },
        {
            "path": "~/.config/fish/functions/fish_greeting.fish",
            "pattern": "PANDORA_DASHBOARD",
            "label": "fish_greeting sem banner duplicado"
        }
    ],
    "systemd_system": {
        "required": [
            "greetd.service",
            "power-profiles-daemon.service"
        ],
        "optional": [
            "nvidia-powerd.service",
            "nekro_sense.service"
        ],
        "disabled": [
            "sddm.service"
        ]
    },
    "systemd_user": {
        "required": [
            "pandora-gpu-profile.timer"
        ],
        "optional": []
    },
    "greetd": {
        "command": "start-hyprland",
        "keyboard": "br-abnt2",
        "autologin": true,
        "note": "initial_session \u2192 Hyprland; tuigreet s\u00f3 ap\u00f3s logout; lock Caelestia no start"
    },
    "sddm": {
        "theme": "maldives",
        "keyboard": "br-abnt2",
        "note": "opcional \u2014 greeter de boot \u00e9 greetd autologin"
    },
    "scheme": {
        "name": "inferno"
    },
    "runtime_checks": {
        "hypr_monitor_position": true,
        "hypr_config_errors": true,
        "caelestia_shell": true,
        "dashboard_windows": true,
        "spicetify_theme": true,
        "hydra_launcher": true,
        "orion_launcher": true,
        "prism_launcher": true,
        "caelestia_wallpaper": true
    }
}
