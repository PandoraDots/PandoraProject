#!/usr/bin/env bash
# pandora-fast <command…> — run a command with every resource the machine can give it:
# up to 16 build threads (fewer when RAM is short), top CPU weight (own cgroup scope), best I/O class, raised nice and the
# "performance" power profile for as long as it runs. Falls back quietly when a knob is missing.
set -u
# Hardware this is tuned for: 28 threads but only ~16 GB of RAM, so memory — not cores — is the limit.
# Jobs follow the RAM that is free right now (~0.75 GiB per rustc/cc job), capped at 16; link steps
# are kept small by building without full debug info; the scope's MemoryHigh makes the build slow
# down instead of pushing the whole desktop into swap.
JOBS="${PANDORA_BUILD_JOBS:-16}"
CPUS="$(nproc 2>/dev/null || echo "$JOBS")"
((JOBS > CPUS)) && JOBS="$CPUS"
MEM_KB="$(awk '/^MemAvailable:/ {print $2}' /proc/meminfo 2>/dev/null || echo 0)"
TOTAL_KB="$(awk '/^MemTotal:/ {print $2}' /proc/meminfo 2>/dev/null || echo 0)"
if [[ -z "${PANDORA_BUILD_JOBS:-}" && "$MEM_KB" -gt 0 ]]; then
  by_mem=$((MEM_KB / 786432)) # 0.75 GiB per job
  ((by_mem < 2)) && by_mem=2
  ((JOBS > by_mem)) && JOBS="$by_mem"
fi
# Line tables are enough for backtraces; full debug info makes every test/binary link several GB.
# PANDORA_DEBUGINFO=1 keeps the default, or set the CARGO_PROFILE_* variables yourself.
if [[ "${PANDORA_DEBUGINFO:-0}" != 1 ]]; then
  export CARGO_PROFILE_DEV_DEBUG="${CARGO_PROFILE_DEV_DEBUG:-line-tables-only}" \
    CARGO_PROFILE_TEST_DEBUG="${CARGO_PROFILE_TEST_DEBUG:-line-tables-only}"
fi
export MAKEFLAGS="${MAKEFLAGS:--j$JOBS}" CARGO_BUILD_JOBS="${CARGO_BUILD_JOBS:-$JOBS}" \
  CMAKE_BUILD_PARALLEL_LEVEL="${CMAKE_BUILD_PARALLEL_LEVEL:-$JOBS}" NINJAFLAGS="${NINJAFLAGS:--j$JOBS}"
[[ $# -gt 0 ]] || { echo "usage: pandora-fast <command…>" >&2; exit 2; }

cmd=("$@")
# nice: needs a negative-nice limit (limits.d/60-pandora-build.conf, effective after login)
want_nice="${PANDORA_NICE:--10}"
# GNU nice only warns (exit 0) when it cannot lower the value, so check the niceness the child got.
if [[ "$(nice -n "$want_nice" nice 2>/dev/null)" == "$want_nice" ]]; then
  cmd=(nice -n "$want_nice" "${cmd[@]}")
fi
command -v ionice >/dev/null && cmd=(ionice -c 2 -n 0 "${cmd[@]}")
if command -v powerprofilesctl >/dev/null && powerprofilesctl list 2>/dev/null | grep -q performance; then
  cmd=(powerprofilesctl launch -p performance -r "pandora-fast: $1" -- "${cmd[@]}")
fi
# Own scope with the maximum CPU weight (user manager delegates the cpu controller).
if [[ ${EUID:-1} -ne 0 ]] && command -v systemd-run >/dev/null && [[ -S "${XDG_RUNTIME_DIR:-/run/user/$UID}/systemd/private" ]]; then
  props=(-p CPUWeight=10000)
  # MemoryHigh (not Max): reclaim and throttle this build before the rest of the system suffers.
  ((TOTAL_KB > 0)) && props+=(-p "MemoryHigh=$((TOTAL_KB * 80 / 100))K")
  exec systemd-run --user --scope --quiet --collect "${props[@]}" "${cmd[@]}"
fi
exec "${cmd[@]}"
