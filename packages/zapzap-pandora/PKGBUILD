# Maintainer: Pandora Project
# Builds upstream ZapZap with Pandora Inferno palette (red accents).

pkgname=zapzap-pandora
_upstream=zapzap
_pkgname=com.rtosta.zapzap
pkgver=7.4.2
_tag=${pkgver}
pkgrel=1
pkgdesc='ZapZap WhatsApp client with Pandora Inferno (red) Qt theme'
arch=('x86_64')
url="https://github.com/rafatosta/$_upstream"
license=('GPL3')
depends=('python-pyqt6' 'python-pyqt6-webengine' 'dbus-python' 'qt6-wayland' 'python-jaraco.text' 'python-inflect' 'python-pydantic>=1.9.1' 'python-typing_extensions>=4.6.1')
makedepends=('git' 'python-build' 'python-installer' 'python-setuptools>=40.8.0' 'python-wheel' 'desktop-file-utils')
optdepends=('hunspell: spell check')
provides=("$_upstream=$pkgver")
conflicts=("$_upstream")
replaces=("$_upstream")
source=("git+$url#tag=$_tag"
        'com.rtosta.zapzap.nogpu.desktop'
        '0001-inferno-palette.patch'
        '0002-default-dark-theme.patch')
b2sums=('SKIP'
        'SKIP'
        'SKIP'
        'SKIP')

prepare() {
  cd "$_upstream"
  patch -Np1 -i "$srcdir/0001-inferno-palette.patch"
  patch -Np1 -i "$srcdir/0002-default-dark-theme.patch"
}

build() {
  cd "$_upstream"
  rm -rf dist/
  python -m build --wheel --no-isolation
}

package() {
  cd "$_upstream"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 "share/icons/$_pkgname.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/$_pkgname.svg"
  install -Dm644 "share/applications/$_pkgname.desktop" "$pkgdir/usr/share/applications/$_pkgname.desktop"
  install -Dm644 "$srcdir/com.rtosta.zapzap.nogpu.desktop" "$pkgdir/usr/share/applications/com.rtosta.zapzap.nogpu.desktop"
  install -Dm644 "share/metainfo/$_pkgname.appdata.xml" "$pkgdir/usr/share/metainfo/$_pkgname.appdata.xml"

  # Ship Inferno CSS/JS reference copies for deploy_zapzap_theme fallback
  local inferno_css="$startdir/../../overlays/zapzap/customizations/global/css/pandora-inferno.css"
  local inferno_js="$startdir/../../overlays/zapzap/customizations/global/js/pandora-inferno.js"
  if [[ -f "$inferno_css" ]]; then
    install -Dm644 "$inferno_css" "$pkgdir/usr/share/zapzap-pandora/pandora-inferno.css"
  fi
  if [[ -f "$inferno_js" ]]; then
    install -Dm644 "$inferno_js" "$pkgdir/usr/share/zapzap-pandora/pandora-inferno.js"
  fi
}
